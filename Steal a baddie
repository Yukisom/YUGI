local LocalPlayer = Players.LocalPlayer

-- 1. ทําการ Localize ฟังก์ชันดั้งเดิมไว้ในระดับสูงสุด
local NativeKick = LocalPlayer.Kick

-- 2. ดึงเมทอดดั้งเดิมผ่านหน่วยความจําดิบ (Raw Metatable) เพื่อป้องกันการโดนแก้ __index ไว้ก่อนหน้า
local success, rawKick = pcall(function()
    local mt = getrawmetatable and getrawmetatable(game) or debug.getregistry().__index
    if type(mt) == "table" and mt.Kick then
        return mt.Kick
    end
    return NativeKick
end)

local SecureKick = success and rawKick or NativeKick

-- 3. ฟังก์ชันตรวจสอบความปลอดภัยก่อนเรียกใช้งาน (Fingerprint Check)
local function SafeKick(playerInstance, message)
    -- ตรวจสอบว่าฟังก์ชัน SecureKick ยังคงเป็นฟังก์ชันแท้ระดับ Native [C] หรือไม่
    -- หากโดนสคริปต์ภายนอก Hook ค่า debug.info มักจะเปลี่ยนจาก [C] เป็นบรรทัดในสคริปต์ Lua
    local source, line = debug.info(SecureKick, "sl")
    
    if source == "[C]" and line == -1 then
        -- สภาพแวดล้อมปลอดภัย เรียกใช้ฟังก์ชันดั้งเดิม
        pcall(SecureKick, playerInstance, message or "Integrity check failed.")
    else
        -- ตรวจพบว่าฟังก์ชันโดนแทรกแซง (Tampered)
        -- สั่งปิดระงับ Client ทันทีผ่านกลไก Crash หน่วยความจําเพื่อความปลอดภัย
        while true do end 
    end
end

